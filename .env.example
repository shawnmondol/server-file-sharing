# ---------------------------------------------------------------------------
# Copy to .env and edit. .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
# Bind to loopback only. `tailscale serve` is the front door and reaches the
# app over localhost; binding to 0.0.0.0 would expose it to the LAN as well.
HOST=127.0.0.1
PORT=8081
NODE_ENV=production

# --- Storage ---------------------------------------------------------------
# Root of the shared library. Everything the app lists, uploads, and deletes
# is confined to this directory. `~` is expanded.
SHARE_ROOT=~/Documents/SharedFiles

# Where generated thumbnails, the metadata index, and in-flight uploads live.
# Keep this OUTSIDE SHARE_ROOT so cache files never appear in the gallery.
DATA_DIR=~/.local/share/fileshare

# Largest single upload accepted, in bytes. Default 8 GiB.
MAX_UPLOAD_BYTES=8589934592

# --- Auth ------------------------------------------------------------------
# tailscale = trust the identity headers injected by `tailscale serve`.
# none      = no identity check. Local development only. Do not ship this.
AUTH_MODE=tailscale

# Comma-separated tailnet logins allowed to use the app.
# Leave empty to allow any authenticated user on your tailnet.
# ALLOWED_USERS=you@example.com,partner@example.com

# Logins in this list may upload and delete; everyone else is read-only.
# Leave empty to give every allowed user full read/write access.
# WRITE_USERS=you@example.com

# --- Media -----------------------------------------------------------------
# Poster frames for video files require ffmpeg on PATH (`sudo apt install ffmpeg`).
ENABLE_VIDEO_THUMBNAILS=true
FFMPEG_PATH=ffmpeg

# Pixel size of the long edge of a generated thumbnail.
THUMBNAIL_SIZE=480

# Files larger than this are skipped when hashing for the inspector's SHA-256.
# Default 2 GiB. Set to 0 to hash regardless of size.
MAX_HASH_BYTES=2147483648
